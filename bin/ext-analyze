#!/bin/bash
# Static analysis of Chrome extensions in a throwaway, offline container.
# The extension is only read, never executed.
#
#   ext-analyze sample.crx [more.crx folder/ ...]
#   ext-analyze --diff old.crx new.crx
#   ext-analyze --validate ~/corpus [--baseline old/results.json]
#                                (corpus/{benign,malicious}/<category>/<sample>; metrics, no sample code)
#   ext-analyze --update-lists   (on the host, with network: Tranco, Public Suffix List,
#                                 URLhaus if an abuse.ch key is in ~/.config/ext-analyze/urlhaus.key)
#
# Env: EXT_ANALYZE_OUT (default ~/analysis/out), EXT_ANALYZE_IMAGE (default ext-static:latest),
#      EXT_ANALYZE_LISTS (default ~/.cache/ext-analyze/lists), EXT_ANALYZE_INTEL (default ~/analysis/intel,
#      local intel laid over the built-in one; add entries with intel-add)
set -euo pipefail

OUT="${EXT_ANALYZE_OUT:-$HOME/analysis/out}"
IMAGE="${EXT_ANALYZE_IMAGE:-ext-static:latest}"
LISTS="${EXT_ANALYZE_LISTS:-$HOME/.cache/ext-analyze/lists}"
INTEL="${EXT_ANALYZE_INTEL:-$HOME/analysis/intel}"
URLHAUS_KEY_FILE="${HOME}/.config/ext-analyze/urlhaus.key"

usage() { sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }
[ $# -eq 0 ] && usage 1
case "${1:-}" in -h|--help) usage 0 ;; esac

# Download one list to a temp file and move it into place only if it is non-empty,
# so a failed download keeps the previous copy.
fetch() {  # fetch NAME URL FILE
  local tmp="$LISTS/.$3.tmp"
  if curl -fsSL --retry 2 --max-time 300 -o "$tmp" "$2" && [ -s "$tmp" ]; then
    mv "$tmp" "$LISTS/$3"
    META+=("\"$1\": \"$(date -u +%Y-%m-%d)\"")
    echo "  ok   $1"
  else
    rm -f "$tmp"
    echo "  FAIL $1 (keeping previous copy if any)" >&2
  fi
}

if [ "$1" = "--update-lists" ]; then
  mkdir -p "$LISTS"
  META=()
  echo "Updating domain lists in $LISTS ..."
  fetch tranco "https://tranco-list.eu/top-1m.csv.zip" tranco-top-1m.csv.zip
  fetch psl "https://publicsuffix.org/list/public_suffix_list.dat" public_suffix_list.dat
  if [ -s "$URLHAUS_KEY_FILE" ]; then
    # abuse.ch puts the Auth-Key in the URL path; the URL is never printed.
    fetch urlhaus "https://urlhaus-api.abuse.ch/v2/files/exports/$(tr -d '[:space:]' < "$URLHAUS_KEY_FILE")/recent.csv" urlhaus.csv
  else
    echo "  skip urlhaus (no key: put your free abuse.ch Auth-Key in $URLHAUS_KEY_FILE)"
  fi
  # keep dates of lists that were not refreshed this time
  if [ -f "$LISTS/meta.json" ]; then
    for k in tranco psl urlhaus; do
      case " ${META[*]-} " in *"\"$k\""*) continue ;; esac
      old=$(grep -o "\"$k\": \"[0-9-]*\"" "$LISTS/meta.json" || true)
      [ -n "$old" ] && META+=("$old")
    done
  fi
  (IFS=,; echo "{${META[*]}}") > "$LISTS/meta.json"
  exit 0
fi

if [ "$1" = "--validate" ]; then
  [ $# -eq 2 ] || [ $# -eq 4 ] || { echo "usage: ext-analyze --validate CORPUS [--baseline results.json]" >&2; exit 1; }
  [ -d "$2" ] || { echo "ext-analyze: corpus folder not found: $2" >&2; exit 1; }
  VMOUNTS=(-v "$(realpath "$2"):/corpus:ro")
  VARGS=(--validate /corpus)
  if [ $# -eq 4 ]; then
    [ "$3" = "--baseline" ] && [ -f "$4" ] || { echo "ext-analyze: --baseline needs a results.json file" >&2; exit 1; }
    VMOUNTS+=(-v "$(realpath "$4"):/baseline.json:ro")
    VARGS+=(--baseline /baseline.json)
  fi
  VOUT="$OUT/validation-$(date -u +%Y%m%d-%H%M%S)"
  mkdir -p "$VOUT"
  [ -d "$LISTS" ] && VMOUNTS+=(-v "$(realpath "$LISTS"):/lists:ro") && VARGS+=(--lists /lists)
  [ -d "$INTEL" ] && VMOUNTS+=(-v "$(realpath "$INTEL"):/intel-local:ro") && VARGS+=(--intel /intel-local)
  VOUT_REAL="$(realpath "$VOUT")"
  docker run --rm \
    --network none \
    --read-only --tmpfs /tmp:rw,size=256m \
    --cap-drop ALL --security-opt no-new-privileges \
    --pids-limit 256 --memory 1g --cpus 1 \
    --user "$(id -u):$(id -g)" \
    "${VMOUNTS[@]}" \
    -v "$VOUT_REAL:/out" \
    "$IMAGE" "${VARGS[@]}" 2>&1 | sed "s#/out/#$VOUT_REAL/#g"
  exit "${PIPESTATUS[0]}"
fi

DIFF=()
if [ "$1" = "--diff" ]; then
  [ $# -eq 3 ] || { echo "usage: ext-analyze --diff OLD NEW" >&2; exit 1; }
  DIFF=(--diff); shift
fi

mkdir -p "$OUT"
MOUNTS=()
ARGS=()
i=0
for s in "$@"; do
  [ -e "$s" ] || { echo "ext-analyze: not found: $s" >&2; exit 1; }
  abs="$(realpath "$s")"
  # each sample is mounted read-only at its own path inside the container
  MOUNTS+=(-v "$abs:/in/$i/$(basename "$abs"):ro")
  ARGS+=("/in/$i/$(basename "$abs")")
  i=$((i + 1))
done

LIST_ARGS=()
if [ -d "$LISTS" ]; then
  MOUNTS+=(-v "$(realpath "$LISTS"):/lists:ro")
  LIST_ARGS=(--lists /lists)
fi
if [ -d "$INTEL" ]; then
  MOUNTS+=(-v "$(realpath "$INTEL"):/intel-local:ro")
  LIST_ARGS+=(--intel /intel-local)
fi

OUT_REAL="$(realpath "$OUT")"
# Container paths (/out/...) are rewritten to host paths in the summary.
docker run --rm \
  --network none \
  --read-only --tmpfs /tmp:rw,size=256m \
  --cap-drop ALL --security-opt no-new-privileges \
  --pids-limit 256 --memory 1g --cpus 1 \
  --user "$(id -u):$(id -g)" \
  "${MOUNTS[@]}" \
  -v "$OUT_REAL:/out" \
  "$IMAGE" "${LIST_ARGS[@]}" "${DIFF[@]}" "${ARGS[@]}" 2>&1 | sed "s#/out/#$OUT_REAL/#g"
